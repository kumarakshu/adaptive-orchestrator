# Application Configuration
APP_NAME="Adaptive LLM Orchestrator"
APP_ENV="development"
# Set DEBUG to true only during local development; defaults to false for production
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# Security & CORS Configuration
# Safe default is empty (disallows cross-origin browser requests).
# If a frontend is added, configure allowed origin(s) as a comma-separated list or JSON array:
# e.g. CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
# Note: Wildcard "*" can be used for uncredentialed testing, but credentials are automatically disabled.
CORS_ALLOWED_ORIGINS=""
CORS_ALLOW_CREDENTIALS=false

# Redis Cache & Context Management
# Enable Redis for session context persistence; if false or unreachable, in-memory store is used
USE_REDIS=false
REDIS_URL="redis://localhost:6379/0"
CONTEXT_TTL_SECONDS=86400

# Observability & Metrics
METRICS_ENABLED=true
LOG_LEVEL="INFO"

# LLM Provider API Keys (Placeholder keys - do not commit real credentials)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Orchestrator Policy Configuration
DEFAULT_TIMEOUT_SECONDS=30
MAX_ESCALATION_RETRIES=2
CONFIDENCE_THRESHOLD=0.75

